# PyInstaller scratch (regenerated by build_installer_exe.py)
_installer/build/

# Python caches
__pycache__/
*.py[cod]

# Local logs and machine-specific diagnosis reports
*.log
nanoamp_diagnose.txt

# NOTE: install.exe, _offline/ (R installer, 109 R packages, minimap2),
# 01_R-package/*.tar.gz and 03_GUI/nanoamp.exe ARE tracked on purpose.
# This directory is the deliverable that gets handed to a user, so it must
# work from a plain clone/USB copy with no network. See README.md for the
# size breakdown and the reasoning.

# The root .gitignore excludes nanoamp_*.tar.gz (R CMD build leftovers).
# The copy under 01_R-package/ is a release artifact and must be kept.
!01_R-package/nanoamp_0.1.0.tar.gz
